{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(client_ip_headers) {
	header_up -X-Forwarded-For
	header_up X-Forwarded-For {client_ip}
	header_up -X-Real-IP
	header_up X-Real-IP {client_ip}
	header_up -CF-Connecting-IP
	header_up -DO-Connecting-IP
}

(cloudflare_origin_pull) {
	tls {
		client_auth {
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
			mode require_and_verify
		}
	}
}

{$REACHSOCIAL_ADDRESS} {
	import cloudflare_origin_pull
	encode zstd gzip

	@owner path /v1/owner/*
	basic_auth @owner {
		{$REACHSOCIAL_ADMIN_USER} {$REACHSOCIAL_ADMIN_PASSWORD_HASH}
	}

	reverse_proxy app:8000 {
		import client_ip_headers
	}
}

{$LIBERATED_ADDRESS:liberated.site} {
	import cloudflare_origin_pull
	encode zstd gzip

	reverse_proxy aeu:3000 {
		import client_ip_headers
	}
}

www.{$LIBERATED_ADDRESS:liberated.site} {
	redir https://{$LIBERATED_ADDRESS:liberated.site}{uri} permanent
}
