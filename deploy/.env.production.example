APP_ENV=production
PUBLIC_BASE_URL=https://reachsocial.dev
REACHSOCIAL_DOMAIN=reachsocial.dev
REACHSOCIAL_ADDRESS=reachsocial.dev
REACHSOCIAL_IMAGE=registry.digitalocean.com/REPLACE/reachsocial:REPLACE
REACHSOCIAL_ADMIN_USER=owner
REACHSOCIAL_ADMIN_PASSWORD_HASH='$2a$14$REPLACE_WITH_CADDY_HASH'
ADMIN_API_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_VALUE
SCRAPECREATORS_API_KEY=
APIFY_API_TOKEN=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
SUPPORT_EMAIL=support@reachsocial.dev
# Keep false until encrypted off-Droplet backup and restore verification are complete.
EXTERNAL_BACKUP_ENABLED=false
# Mainnet requires this explicit acknowledgement, an external backup, and verified margins.
ALLOW_MAINNET_X402=false
MINIMUM_PUBLIC_MARGIN_CENTS=1
MAINTENANCE_INTERVAL_HOURS=24
MCP_ENABLED=false
X402_ENABLED=false
X402_NETWORK=eip155:8453
X402_PAY_TO=0x457d76fb1a0ce5414df9261179bf8547d58d3f86
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
DEFAULT_RATE_LIMIT_PER_MINUTE=30
DEFAULT_CONCURRENCY_LIMIT=2
DEFAULT_DAILY_SPEND_CENTS=5000
PROVIDER_CONCURRENCY_LIMIT=4
MAX_DAILY_UPSTREAM_COST_CENTS=10000
CACHE_TTL_SECONDS=60
REQUEST_RETENTION_DAYS=30
